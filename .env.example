# Tibia Data Vault Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Database Configuration
# =============================================================================
# Path to the SQLite database file (default: tibia_data.db in project root)
# TIBIA_DB_PATH=./tibia_data.db

# =============================================================================
# API Server Configuration
# =============================================================================
# Host to bind the Flask API server (default: 0.0.0.0)
# TIBIA_API_HOST=0.0.0.0

# Port for the Flask API server (default: 5000)
# TIBIA_API_PORT=5000

# Enable Flask debug mode (default: false)
# TIBIA_API_DEBUG=false

# =============================================================================
# External API Configuration
# =============================================================================
# Base URL for tibiamarket.top API (default: https://api.tibiamarket.top)
# TIBIA_MARKET_API_URL=https://api.tibiamarket.top

# Timeout for API requests in seconds (default: 30)
# TIBIA_REQUEST_TIMEOUT=30

# Delay between per-server requests in seconds (default: 30)
# TIBIA_REQUEST_DELAY=30

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# TIBIA_LOG_LEVEL=INFO
